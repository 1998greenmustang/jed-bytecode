import io

func main 0 {
	push_lit 1000000
	store_name n

# create prime list 
	push_lit false
	push_lit false
	push_name n
	push_lit 1
	call jedop_sub
	push_many_lits true
	create_list

	store_name prime

# falsify prime index
	# range(2, math.sqrt(n) + 1)
	push_lit 2
	
	push_name n
	call jed_sqrt
	push_lit 1
	call jedop_add
	
	push_lit 1

	range_loop {
		store_temp
		push_name prime
		push_temp
		list_get

		do_if {
			push_temp
			push_temp
			call jedop_mul

			push_name n
			push_lit 1
			call jedop_add

			push_temp
			range_loop {
				store_temp
				push_lit false
				push_name prime
				push_temp
				list_set
			}
		}
	}

	push_name prime
	create_iter
	store_name it
	push_name it
	iterate {
		do_if {
			push_name it
			iter_current
			call io:println
		}
	}
}
call main
